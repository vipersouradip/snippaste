<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBFBFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#18181B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Tap the bubble, drag a region, and it is pasted where you are typing."
            android:textSize="14sp"
            android:textColor="#71717A" />

        <TextView
            android:id="@+id/statusOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textSize="15sp"
            android:textColor="#18181B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required. Lets the snip bubble float over other apps."
            android:textSize="12sp"
            android:textColor="#71717A" />

        <Button
            android:id="@+id/buttonOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Grant" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E4E4E9" />

        <TextView
            android:id="@+id/statusPaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textSize="15sp"
            android:textColor="#18181B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optional. Without it the snip is copied and a share sheet opens instead of pasting automatically."
            android:textSize="12sp"
            android:textColor="#71717A" />

        <Button
            android:id="@+id/buttonPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open accessibility settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E4E4E9" />

        <Button
            android:id="@+id/buttonToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Start bubble" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="#71717A"
            android:text="Android asks permission to capture the screen each time the bubble starts. Snips after that are a single tap." />
    </LinearLayout>
</ScrollView>
