{
  "manifest_version": 3,
  "name": "SnipPaste — snip & paste into any input",
  "version": "1.2.1",
  "description": "Click the snip button on any text box, drag a region of your screen with the Windows snipping overlay, and it is pasted in automatically.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "SnipPaste",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "snip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Snip anything on screen into the focused text box"
    }
  }
}
